generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KitchenStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ItemType {
  COMPONENT
  ACCESSORY
  SERVICE
}

enum OrderStatus {
  NEW
  EMAILED
  CONFIRMED
  CANCELLED
}

enum OrderCancellationRequestStatus {
  RECEIVED
  APPROVED
  REJECTED
}

enum AdminRole {
  SUPERADMIN
  PX_ADMIN
  ADMIN
  USER
}

model AdminUser {
  id                         String    @id @default(cuid())
  email                      String    @unique
  passwordHash               String
  role                       AdminRole @default(ADMIN)
  isActive                   Boolean   @default(true)
  loginVerificationCodeHash  String?
  loginVerificationExpiresAt DateTime?
  loginVerificationAttempts  Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// AB documents are retained independently so an AB can arrive before its kitchen.
model KitchenAbDocument {
  id           String                 @id
  sha256       String                 @unique
  kitchenSlug  String
  metadata     Json
  pdfBytes     Bytes?
  pdfStorageKey String?
  status       String                 @default("REVIEW")
  importedAt   DateTime               @default(now())
  lastReadAt   DateTime?              @db.Timestamptz(3)
  reviewedAt   DateTime?
  reviewedBy   String?
  publications KitchenAbPublication[]

  @@index([kitchenSlug, importedAt])
  @@index([lastReadAt(sort: Desc)])
}

model KitchenAbPublication {
  kitchenSlug String            @id
  documentId  String
  document    KitchenAbDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  updatedAt   DateTime          @default(now())
}

model KitchenAbSyncRun {
  id         String    @id
  source     String
  status     String    @default("RUNNING")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  summary    Json      @default("{}")

  @@index([startedAt])
}

// Processing is independent of order/payment/email status. Absence means OPEN.
model WorkProcessing {
  id             String   @id @default(cuid())
  workType       String
  workId         String
  status         String   @default("OPEN")
  assignedTo     String?
  completedAt    DateTime?
  completedBy    String?
  lastReminderAt DateTime?
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([workType, workId])
  @@index([status, lastReminderAt])
}

model WorkProcessingEvent {
  id           String   @id @default(cuid())
  workType     String
  workId       String
  actor        String
  fromStatus   String
  toStatus     String
  fromAssignee String?
  toAssignee   String?
  createdAt    DateTime @default(now())

  @@index([workType, workId, createdAt])
}

// Durable SMTP attempts are committed separately from processing updates.
// UNKNOWN requires review: SMTP cannot guarantee exactly-once delivery.
model WorkReminderBatch {
  id         String   @id @default(cuid())
  dateKey    String   @unique
  status     String   @default("SENDING")
  items      Json
  startedAt  DateTime @default(now())
  sentAt     DateTime?
  error      String?  @db.Text
  messageId  String?

  @@index([status, startedAt])
}

model CatalogArticle {
  id                  String                       @id @default(cuid())
  articleNumber       String                       @unique
  name                String
  nameDe              String?
  description         String?
  widthMm             Int?
  heightMm            Int?
  depthMm             Int?
  price               Decimal                      @db.Decimal(10, 2)
  itemType            ItemType
  productImagePath         String?
  productInfoPdfPath       String?
  productInfoSummary       String?
  productInfoKeyFacts      Json?
  productInfoExtractedText String?
  productInfoUpdatedAt     DateTime?
  isFixedPricePackage Boolean                      @default(false)
  isActive            Boolean                      @default(true)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  kitchenItems        KitchenItem[]
  priceHistory        CatalogArticlePriceHistory[]
  programPrices       CatalogArticleProgramPrice[]
}

model CatalogBlende {
  id            String                      @id @default(cuid())
  code          String                      @unique
  name          String
  nameDe        String?
  description   String?
  price         Decimal                     @db.Decimal(10, 2)
  isActive      Boolean                     @default(true)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  kitchenItems  KitchenItem[]
  priceHistory  CatalogBlendePriceHistory[]
  programPrices CatalogBlendeProgramPrice[]
}

model CatalogService {
  id            String                       @id @default(cuid())
  code          String                       @unique
  name          String
  nameDe        String?
  description   String?
  price         Decimal                      @db.Decimal(10, 2)
  isActive      Boolean                      @default(true)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  kitchenItems  KitchenItem[]
  priceHistory  CatalogServicePriceHistory[]
  programPrices CatalogServiceProgramPrice[]
}

model CatalogProgram {
  id          String   @id @default(cuid())
  programmId  String   @unique
  name        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CatalogPriceListImport {
  id                              String                       @id @default(cuid())
  label                           String?
  sourceName                      String?
  programmId                      String?
  status                          String                       @default("APPLIED")
  notes                           String?
  importedBy                      String?
  createdCount                    Int                          @default(0)
  updatedCount                    Int                          @default(0)
  unchangedCount                  Int                          @default(0)
  failedCount                     Int                          @default(0)
  syncedKitchenItemCount          Int                          @default(0)
  effectiveFrom                   DateTime?
  syncLinkedKitchenItemsRequested Boolean                      @default(false)
  syncAppliedAt                   DateTime?
  createdAt                       DateTime                     @default(now())
  appliedAt                       DateTime?
  articleHistory                  CatalogArticlePriceHistory[]
  blendeHistory                   CatalogBlendePriceHistory[]
  serviceHistory                  CatalogServicePriceHistory[]
  rows                            CatalogPriceListImportRow[]

  @@index([status, effectiveFrom])
}

model CatalogPriceListImportRow {
  id                  String                 @id @default(cuid())
  importId            String
  import              CatalogPriceListImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  itemKind            String
  identifier          String
  articleNumber       String?
  code                String?
  name                String
  nameDe              String?
  description         String?
  widthMm             Int?
  heightMm            Int?
  depthMm             Int?
  itemType            ItemType?
  price               Decimal                @db.Decimal(10, 2)
  isFixedPricePackage Boolean?
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now())

  @@index([importId])
  @@index([itemKind])
  @@index([identifier])
}

model CatalogArticleProgramPrice {
  id               String         @id @default(cuid())
  programmId       String
  catalogArticleId String
  catalogArticle   CatalogArticle @relation(fields: [catalogArticleId], references: [id], onDelete: Cascade)
  articleNumber    String
  price            Decimal        @db.Decimal(10, 2)
  isActive         Boolean        @default(true)
  updatedAt        DateTime       @updatedAt
  createdAt        DateTime       @default(now())

  @@unique([programmId, catalogArticleId])
  @@index([programmId])
  @@index([articleNumber])
}

model CatalogBlendeProgramPrice {
  id              String        @id @default(cuid())
  programmId      String
  catalogBlendeId String
  catalogBlende   CatalogBlende @relation(fields: [catalogBlendeId], references: [id], onDelete: Cascade)
  code            String
  price           Decimal       @db.Decimal(10, 2)
  isActive        Boolean       @default(true)
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())

  @@unique([programmId, catalogBlendeId])
  @@index([programmId])
  @@index([code])
}

model CatalogServiceProgramPrice {
  id               String         @id @default(cuid())
  programmId       String
  catalogServiceId String
  catalogService   CatalogService @relation(fields: [catalogServiceId], references: [id], onDelete: Cascade)
  code             String
  price            Decimal        @db.Decimal(10, 2)
  isActive         Boolean        @default(true)
  updatedAt        DateTime       @updatedAt
  createdAt        DateTime       @default(now())

  @@unique([programmId, catalogServiceId])
  @@index([programmId])
  @@index([code])
}

model CatalogArticlePriceHistory {
  id               String                  @id @default(cuid())
  importId         String?
  import           CatalogPriceListImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  catalogArticleId String?
  catalogArticle   CatalogArticle?         @relation(fields: [catalogArticleId], references: [id], onDelete: SetNull)
  articleNumber    String
  oldPrice         Decimal?                @db.Decimal(10, 2)
  newPrice         Decimal                 @db.Decimal(10, 2)
  changedAt        DateTime                @default(now())

  @@index([importId])
  @@index([catalogArticleId])
  @@index([articleNumber])
}

model CatalogBlendePriceHistory {
  id              String                  @id @default(cuid())
  importId        String?
  import          CatalogPriceListImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  catalogBlendeId String?
  catalogBlende   CatalogBlende?          @relation(fields: [catalogBlendeId], references: [id], onDelete: SetNull)
  code            String
  oldPrice        Decimal?                @db.Decimal(10, 2)
  newPrice        Decimal                 @db.Decimal(10, 2)
  changedAt       DateTime                @default(now())

  @@index([importId])
  @@index([catalogBlendeId])
  @@index([code])
}

model CatalogServicePriceHistory {
  id               String                  @id @default(cuid())
  importId         String?
  import           CatalogPriceListImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  catalogServiceId String?
  catalogService   CatalogService?         @relation(fields: [catalogServiceId], references: [id], onDelete: SetNull)
  code             String
  oldPrice         Decimal?                @db.Decimal(10, 2)
  newPrice         Decimal                 @db.Decimal(10, 2)
  changedAt        DateTime                @default(now())

  @@index([importId])
  @@index([catalogServiceId])
  @@index([code])
}

model Kitchen {
  id          String             @id @default(cuid())
  slug        String             @unique
  kitchenCode String?
  programmId  String             @default("IP 2200")
  name        String
  status      KitchenStatus      @default(DRAFT)
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  items       KitchenItem[]
  claimParts  KitchenClaimPart[]
  orders      Order[]
  testOrders  TestOrder[]
  contracts   KitchenContract[]
}

model KitchenClaimPart {
  id                       String   @id @default(cuid())
  kitchenId                String
  kitchen                  Kitchen  @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  partKey                  String
  name                     String
  nameDe                   String?
  articleCode              String?
  sourceKitchenItemCode    String?
  sourceComponentKey       String?
  productImagePath         String?
  productInfoPdfPath       String?
  productInfoSummary       String?
  productInfoKeyFacts      Json?
  productInfoExtractedText String?
  productInfoUpdatedAt     DateTime?
  isActive                 Boolean  @default(true)
  sortOrder                Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([kitchenId, partKey])
  @@index([kitchenId, isActive])
}

model KitchenItem {
  id                       String          @id @default(cuid())
  kitchenId                String
  kitchen                  Kitchen         @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  itemType                 ItemType
  code                     String
  articleNumber            String?
  name                     String
  nameDe                   String?
  price                    Decimal         @db.Decimal(10, 2)
  widthMm                  Int?
  heightMm                 Int?
  depthMm                  Int?
  infoText                 String?
  productImagePath         String?
  productInfoPdfPath       String?
  productInfoSummary       String?
  productInfoKeyFacts      Json?
  productInfoExtractedText String?
  productInfoUpdatedAt     DateTime?
  iconKey                  String?
  colorKey                 String?
  componentKey             String?
  isLocked                 Boolean         @default(false)
  isActive                 Boolean         @default(true)
  sortOrder                Int             @default(0)
  blendeCode               String?
  blendeLabel              String?
  blendePrice              Decimal?        @db.Decimal(10, 2)
  catalogArticleId         String?
  catalogArticle           CatalogArticle? @relation(fields: [catalogArticleId], references: [id], onDelete: SetNull)
  catalogBlendeId          String?
  catalogBlende            CatalogBlende?  @relation(fields: [catalogBlendeId], references: [id], onDelete: SetNull)
  catalogBlendeQuantity    Int?
  catalogServiceId         String?
  catalogService           CatalogService? @relation(fields: [catalogServiceId], references: [id], onDelete: SetNull)
  catalogLinkStatus        String?
  catalogPriceSyncMode     String          @default("AUTO")
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  orderItems               OrderItem[]
  testOrderItems           TestOrderItem[]

  @@unique([kitchenId, code])
  @@index([catalogArticleId])
  @@index([catalogBlendeId])
  @@index([catalogServiceId])
}

model Order {
  id                      String           @id @default(cuid())
  orderNumber             String           @unique
  kitchenId               String
  kitchen                 Kitchen          @relation(fields: [kitchenId], references: [id], onDelete: Restrict)
  kitchenContractId       String?
  kitchenContract         KitchenContract? @relation(fields: [kitchenContractId], references: [id], onDelete: SetNull)
  status                  OrderStatus      @default(NEW)
  contractNumber          String?
  as400Number             String?
  firstName               String
  lastName                String
  email                   String
  phone                   String
  address1                String
  address2                String?
  postalCode              String
  city                    String
  country                 String?
  preferredDeliveryDate   DateTime?
  notes                   String?
  paymentMethod           String?
  paymentStatus           String           @default("UNPAID")
  stripeCheckoutSessionId String?          @unique
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  totalPrice              Decimal          @db.Decimal(10, 2)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  items                   OrderItem[]
  cancellationRequests    OrderCancellationRequest[]
  confirmationEmailDelivery Json?

  @@index([kitchenContractId])
  @@index([kitchenContractId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

// Independent audit records: deliberately no relation/foreign key to orders.
// Tracking must never lock or update rows in the checkout/order workflow.
model OrderEmailAttempt {
  id          String   @id
  orderId     String
  orderKind   String
  attemptedAt DateTime
  delivery    Json
  createdAt   DateTime @default(now())

  @@index([orderKind, orderId, attemptedAt(sort: Desc), createdAt(sort: Desc)])
}

model OrderCancellationRequest {
  id                      String                         @id @default(cuid())
  referenceNumber         String                         @unique
  orderId                 String?
  order                   Order?                         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  submittedContractNumber String
  productDescription      String?                        @db.Text
  orderedOn               DateTime?
  receivedOn              DateTime?
  consumerName            String
  consumerAddress         String?                        @db.Text
  confirmationEmail       String
  language                String                         @default("de")
  reason                  String?                        @db.Text
  declarationText         String                         @db.Text
  status                  OrderCancellationRequestStatus @default(RECEIVED)
  receivedAt              DateTime                       @default(now())
  processedAt             DateTime?
  adminNote               String?                        @db.Text
  customerEmailStatus     String                         @default("PENDING")
  customerEmailSentAt     DateTime?
  internalEmailStatus     String                         @default("PENDING")
  internalEmailSentAt     DateTime?
  finalEmailStatus        String                         @default("NOT_REQUIRED")
  finalEmailSentAt        DateTime?
  lastEmailError          String?                        @db.Text
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  @@index([orderId, status])
  @@index([status, receivedAt])
  @@index([submittedContractNumber, confirmationEmail])
}

model TestOrder {
  id                      String           @id @default(cuid())
  orderNumber             String           @unique
  kitchenId               String
  kitchen                 Kitchen          @relation(fields: [kitchenId], references: [id], onDelete: Restrict)
  kitchenContractId       String?
  kitchenContract         KitchenContract? @relation(fields: [kitchenContractId], references: [id], onDelete: SetNull)
  status                  OrderStatus      @default(NEW)
  contractNumber          String?
  firstName               String
  lastName                String
  email                   String
  phone                   String
  address1                String
  address2                String?
  postalCode              String
  city                    String
  country                 String?
  preferredDeliveryDate   DateTime?
  notes                   String?
  paymentMethod           String?
  paymentStatus           String           @default("UNPAID")
  stripeCheckoutSessionId String?          @unique
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  totalPrice              Decimal          @db.Decimal(10, 2)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  items                   TestOrderItem[]
  confirmationEmailDelivery Json?

  @@index([kitchenContractId])
  @@index([kitchenContractId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model KitchenContract {
  id                   String                         @id @default(cuid())
  contractNumber       String                         @unique
  contractType         String                         @default("FRG")
  kitchenId            String
  kitchen              Kitchen                        @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  projectId            String?
  project              Project?                       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  claimPlanPdfPath     String?
  claimPlanPreviewPath String?
  isActive             Boolean                        @default(true)
  usedAt               DateTime?
  building             String?
  floor                String?
  unitNumber           String?
  notes                String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  orders               Order[]
  testOrders           TestOrder[]
  registrations        KitchenRegistration[]
  visitEvents          PublicVisitEvent[]
  claimPlanAsset       KitchenContractClaimPlanAsset?
  appliances           ContractAppliance[]
  appliancesConfigured Boolean                        @default(false)

  @@index([kitchenId])
  @@index([projectId])
  @@index([contractType])
}

model ContractAppliance {
  id                String          @id @default(cuid())
  kitchenContractId String
  kitchenContract   KitchenContract @relation(fields: [kitchenContractId], references: [id], onDelete: Cascade)
  applianceType     String
  brand             String?
  articleNumber     String?
  serialHelpProfile String?
  source            String          @default("MANUAL")
  isPresent         Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([kitchenContractId, applianceType])
  @@index([kitchenContractId])
  @@index([applianceType, brand])
}

model KitchenContractClaimPlanAsset {
  id                String          @id @default(cuid())
  kitchenContractId String          @unique
  kitchenContract   KitchenContract @relation(fields: [kitchenContractId], references: [id], onDelete: Cascade)
  previewBytes      Bytes?
  previewMimeType   String?
  previewFileName   String?
  pdfBytes          Bytes?
  pdfMimeType       String?
  pdfFileName       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([kitchenContractId])
}

model KitchenRegistration {
  id                    String          @id @default(cuid())
  kitchenContractId     String
  kitchenContract       KitchenContract @relation(fields: [kitchenContractId], references: [id], onDelete: Cascade)
  fullName              String
  email                 String?
  phone                 String?
  addressNote           String?
  isActive              Boolean         @default(true)
  verificationCodeHash  String?
  verificationExpiresAt DateTime?
  verificationAttempts  Int             @default(0)
  verifiedAt            DateTime?
  registeredAt          DateTime        @default(now())
  deactivatedAt         DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([kitchenContractId, isActive])
  @@index([email])
  @@index([phone])
}

model HousingCompany {
  id              String           @id @default(cuid())
  name            String
  address         String?
  email           String?
  phone           String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  projects        Project[]
  propertyObjects PropertyObject[]
}

model Project {
  id               String            @id @default(cuid())
  name             String
  projectCode      String?
  status           String            @default("active")
  description      String?
  managerName      String?
  housingCompanyId String
  housingCompany   HousingCompany    @relation(fields: [housingCompanyId], references: [id], onDelete: Cascade)
  propertyObjectId String            @unique
  propertyObject   PropertyObject    @relation(fields: [propertyObjectId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contracts        KitchenContract[]

  @@unique([housingCompanyId, name])
  @@index([housingCompanyId])
}

model PropertyObject {
  id               String         @id @default(cuid())
  name             String
  housingCompanyId String
  housingCompany   HousingCompany @relation(fields: [housingCompanyId], references: [id], onDelete: Cascade)
  project          Project?
  contactPhone     String?
  country          String?
  city             String?
  postalCode       String?
  address1         String?
  address2         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([housingCompanyId])
}

model OrderItem {
  id                    String       @id @default(cuid())
  orderId               String
  order                 Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kitchenItemId         String?
  kitchenItem           KitchenItem? @relation(fields: [kitchenItemId], references: [id], onDelete: SetNull)
  itemType              ItemType
  code                  String
  nameSnapshot          String
  nameDeSnapshot        String?
  articleNumberSnapshot String?
  priceSnapshot         Decimal      @db.Decimal(10, 2)
  quantity              Int          @default(1)
  createdAt             DateTime     @default(now())

  @@index([orderId])
}

model TestOrderItem {
  id                    String       @id @default(cuid())
  orderId               String
  order                 TestOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kitchenItemId         String?
  kitchenItem           KitchenItem? @relation(fields: [kitchenItemId], references: [id], onDelete: SetNull)
  itemType              ItemType
  code                  String
  nameSnapshot          String
  nameDeSnapshot        String?
  articleNumberSnapshot String?
  priceSnapshot         Decimal      @db.Decimal(10, 2)
  quantity              Int          @default(1)
  createdAt             DateTime     @default(now())

  @@index([orderId])
}

// Independent delivery log; no foreign key or update to ServiceClaim.
model ServiceClaimEmailAttempt {
  id          String   @id
  claimId     String
  attemptedAt DateTime
  delivery    Json
  createdAt   DateTime @default(now())

  @@index([claimId, attemptedAt(sort: Desc), createdAt(sort: Desc)])
}

model ServiceClaim {
  submissions          ServiceClaimSubmission[]
  ticketNumber         Int      @default(dbgenerated())
  ticketSeries         String   @default("live")
  id                   String   @id
  contractNumber       String
  claimSequence        Int
  fullName             String
  phone                String?
  email                String?
  clientAddress        String?
  clientCountry        String?
  clientCity           String?
  clientPostalCode     String?
  landlordName         String?
  landlordCompanyPhone String?
  landlordCompanyEmail String?
  landlordPhone        String?
  landlordEmail        String?
  hausmeisterName      String?
  hausmeisterPhone     String?
  hausmeisterEmail     String?
  landlordContact      String
  problemDescription   String
  serialNumber         String
  requestType          String   @default("complaint")
  problemAreasJson     String?  @db.Text
  attachmentsJson      String?  @db.Text
  createdAt            DateTime @default(now())

  @@unique([contractNumber, claimSequence])
  @@unique([ticketSeries, ticketNumber])
  @@index([contractNumber])
  @@index([createdAt])
}

model ServiceClaimSubmission {
  id              String @id
  claimId         String
  claim           ServiceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  payload         Json
  attachmentStart Int @default(0)
  createdAt       DateTime @default(now())

  @@index([claimId, createdAt])
}

model ClaimFeedbackInvitation {
  id                String    @id @default(cuid())
  claimId           String
  completionVersion Int
  recipientEmail    String?
  tokenHash         String?   @unique
  status            String    @default("PENDING")
  expiresAt         DateTime?
  attemptedAt       DateTime?
  sentAt            DateTime?
  submittedAt       DateTime?
  overallRating     Int?
  speedRating       Int?
  communicationRating Int?
  resolved          String?
  comment           String?   @db.Text
  unresolvedComment String?   @db.Text
  error             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([claimId, completionVersion])
  @@index([claimId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

model PublicVisitEvent {
  id                  String           @id @default(cuid())
  eventType           String
  source              String?
  utmMedium           String?
  utmCampaign         String?
  referrerHost        String?
  path                String?
  countryCode         String?          @db.VarChar(2)
  deviceType          String?
  browserFamily       String?
  operatingSystem     String?
  visitorKey          String?
  kitchenContractId   String?
  kitchenContract     KitchenContract? @relation(fields: [kitchenContractId], references: [id], onDelete: SetNull)
  contractNumber      String?          @db.VarChar(200)
  contractNumberHash  String?
  contractNumberLast4 String?
  ipHash              String?
  userAgentHash       String?
  metadata            Json?
  createdAt           DateTime         @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([contractNumberHash])
  @@index([countryCode, createdAt])
  @@index([source, createdAt])
  @@index([visitorKey, createdAt])
  @@index([kitchenContractId, createdAt])
}

model ServiceClaimKnowledgeEntry {
  id            String   @id @default(cuid())
  slug          String   @unique
  brand         String
  applianceType String
  topicType     String
  code          String?
  titleKey      String
  symptomKeys   Json?
  checkKeys     Json?
  causeKeys     Json?
  actionKeys    Json?
  triggerTerms  Json?
  priority      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([brand, applianceType, isActive])
  @@index([topicType, code])
}

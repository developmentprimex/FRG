DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fragmento?schema=public"
ADMIN_EMAIL="01primex.eu@gmail.com"
ORDER_CANCELLATION_EMAIL="01primex.eu@gmail.com"
ADMIN_PASSWORD="admin123"
ADMIN_SESSION_SECRET="change-me-too-local-dev"
# Use a separate long random value in production. It protects one-way visit and contract hashes.
VISIT_TRACKING_SALT="change-me-random-visit-tracking-salt"
# Detailed privacy-first visit events are automatically removed after this many days (1-365).
# Retention for general visit analytics only; contract access logs are kept indefinitely.
VISIT_TRACKING_RETENTION_DAYS="90"
# The daily access report is enabled only by the Hetzner systemd service.
CONTRACT_ACCESS_REPORT_ENABLED="false"
CONTRACT_ACCESS_REPORT_EMAIL="it@forestdream.de,334primex.eu@gmail.com,01primex.eu@gmail.com"
# Claims for contract numbers beginning with 111.
SERVICE_REQUEST_EMAIL=""
# Claims for all other contract numbers.
SERVICE_REQUEST_OTHER_EMAIL="kd@myarchitecto.de"
# Primary admin (e.g. client): full dashboard, no Claims in sidebar.
# Claims-only admin: set email/password below, then run `node scripts/create-admin.js`.
ADMIN_CLAIMS_EMAIL="elsa@example.com"
ADMIN_CLAIMS_PASSWORD="elsa123"
# Must include ADMIN_CLAIMS_EMAIL (comma-separated if you add more later).
ADMIN_CLAIMS_ACCESS_EMAILS="elsa@example.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# SMTP settings above are required for admin two-step sign-in verification emails.
N8N_WEBHOOK_URL=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_TEST_SECRET_KEY=""
STRIPE_TEST_WEBHOOK_SECRET=""
STRIPE_CURRENCY="eur"
OPENAI_API_KEY=""
OPENAI_PRODUCT_INFO_MODEL="gpt-5.2"
OPENAI_CLAIM_ASSISTANT_MODEL="gpt-5.1"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
ELEVENLABS_SPEED="0.78"
ELEVENLABS_OUTPUT_FORMAT="mp3_44100_128"

# Overdue reminders: enabled by the hosted systemd service only.
# Default command is a dry run: npm run report:work-reminders
# Reminder recipient is fixed to 140primex.eu@gmail.com; no sender fallback.
WORK_REMINDERS_ENABLED="false"
WORK_DASHBOARD_URL="https://fragmento.de"
# Public origin used for customer feedback links. Use http://localhost:3000 locally; local email is redirected to 334primex.eu@gmail.com.
# Feedback uses SMTP_111_* or SMTP_* only when the authenticated user and sender are both 315primex.eu@gmail.com.
# Optional local-only exception for one feedback test mailbox; all other local email still goes to 334primex.eu@gmail.com.
LOCAL_CLAIM_FEEDBACK_RECIPIENT=""
CLAIM_FEEDBACK_BASE_URL="https://fragmento.de"
SMTP_111_HOST="smtp.gmail.com"
SMTP_111_PORT="587"
SMTP_111_SECURE="false"
SMTP_111_USER="315primex.eu@gmail.com"
SMTP_111_FROM="315primex.eu@gmail.com"
SMTP_111_PASS=""
